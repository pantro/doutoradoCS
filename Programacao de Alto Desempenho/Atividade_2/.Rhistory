setwd("~/Descargas/codigo/")
# Leyendo lo datos del archivo
data <- read.csv("measurements.csv")
View(data)
install.packages(c("ggplot2", "dplyr", "readr"))
library(ggplot2)
library(dplyr)
data512 <- filter(data, N == 512)
ggplot(data512, aes(x = reorder(method, -MFLOPS), y = MFLOPS, fill = method)) +
geom_bar(stat = "identity", color = "black") +
theme_minimal(base_size = 14) +
labs(title = "Performance comparison (N = 512)",
x = "Method",
y = "MFLOPS") +
theme(axis.text.x = element_text(angle = 45, hjust = 1),
legend.position = "none")
View(data)
ggplot(data512, aes(x = reorder(mode, -MFLOPS), y = MFLOPS, fill = mode)) +
geom_bar(stat = "identity", color = "black") +
theme_minimal(base_size = 14) +
labs(title = "Performance comparison (N = 512)",
x = "Method",
y = "MFLOPS") +
theme(axis.text.x = element_text(angle = 45, hjust = 1),
legend.position = "none")
# Leyendo lo datos del archivo
data <- read.csv("measurements.csv")
# Limpieza de espacios y texto en la columna de tiempo
data$real_time_s <- gsub(" time\\(s\\)=", "", data$real_time_s)
data$real_time_s <- trimws(data$real_time_s)
data$real_time_s <- as.numeric(data$real_time_s)
# Verificamos si se convirtió correctamente
summary(data$real_time_s)
data[is.na(data$real_time_s), c("mode", "N", "real_time_s")]
