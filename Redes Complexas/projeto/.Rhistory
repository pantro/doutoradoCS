df <- df%>%
mutate(deathtLag = Death - Report,  #period between report and animal death
renvLag = Shipment - Report, #period between report and shipment
collLag = LabDx - Shipment)  #period between shipment and diagnostic
mean_cullLag<-round(mean(df$CullLag, na.rm = TRUE), digits=2) #Time difference of 2.38 days
median_cullLag<-round(median(df$CullLag, na.rm = TRUE), digits=2) #Time difference of 2 days
mean_deathtLag<-round(mean(df$deathtLag, na.rm = TRUE), digits=2) #Time difference of 0.06 days
median_deathtLag<-round(median(df$deathtLag, na.rm = TRUE), digits=2) #Time difference of 0 days
mean_ReportLag<-round(mean(df$ReportLag, na.rm = TRUE), digits=2) #Time difference of 2.43 days
median_ReportLag<-round(median(df$ReportLag, na.rm = TRUE), digits=2) #Time difference of 2 days
mean_renvLag<-round(mean(df$renvLag, na.rm = TRUE), digits=2) #Time difference of 1.11 days
median_renvLag<-round(median(df$renvLag, na.rm = TRUE), digits=2) #Time difference of 1 days
mean_collLag<-round(mean(df$collLag, na.rm = TRUE), digits=2) #Time difference of 1.14 days
median_collLag<-round(median(df$collLag, na.rm = TRUE), digits=2) #Time difference of 1 days
anho2015<-subset(df,Year==2017)
boxplot( anho2015$ReportLag, anho2015$CullLag, anho2015$SampleLag, anho2015$SampleShipLag, anho2015$DxLag, anho2015$ControlLag)
