# df<-read.csv("Rabies_focus_control_data.csv", sep=",") # The database is in drive "Rabies focus control data"
df<-read.csv("Rabies focus control data - Sheet1.csv", sep=",") # The database is in drive "Rabies focus control data"
#joining the dates
df$Report<- paste(df$complaint_day, df$complaint_month,df$complaint_year , sep="/")
View(df)
install.packages('gsheet')
# Library
library(gsheet)
View(df)
df$InitialSigns<- paste(df$day_sympoms_appeared, df$month_sympoms_appeared,df$year_sympoms_appeared, sep="/")
df$Death<- paste(df$day_killed, df$month_killed,df$year_killed , sep="/")
df$SampleCollection<- paste(df$Sampling_day, df$Sampling_month, df$Sampling_year , sep="/")
df$Shipment<-paste(df$brain_sampling_shipping_day, df$brain_sampling_shipping_month,df$brain_sampling_shipping_year , sep="/")
df$LabDx<- paste(df$Confirmation_day, df$Confirmation_month,df$Confirmation_year , sep="/")
df$FocusControl1<-paste(df$day_containent_started, df$month_containent_started,df$year_containent_started , sep="/")
View(df)
df <- df%>%
mutate(Report = as.Date(Report, format="%d/%m/%Y"),
Death = as.Date(Death, format="%d/%m/%Y"),
InitialSigns = as.Date(InitialSigns, format="%d/%m/%Y"),
SampleCollection = as.Date(SampleCollection, format="%d/%m/%Y"),
Shipment = as.Date(Shipment, format="%d/%m/%Y"),
LabDx = as.Date(LabDx, format="%d/%m/%Y"),
FocusControl1 = as.Date(FocusControl1, format="%d/%m/%Y")) %>%
mutate(ReportLag = Report - InitialSigns,
CullLag = Death-InitialSigns,
SampleLag = SampleCollection-InitialSigns,
SampleShipLag = Shipment-InitialSigns,
DxLag= LabDx-InitialSigns,
ControlLag = FocusControl1 - InitialSigns)
View(df)
df <- df%>%
filter(!is.na(InitialSigns))
View(df)
df <- df%>%
filter(Year!=2019 | case_regional != 39) %>%
filter(Year!=2017 | Locality != "VIA EVITAMIENTO KM 9")%>%
filter(Year!=2017 | Locality != "APIPA SECTOR XV") %>%
filter(Year!=2015 | Locality != "SANTA ROSA") %>%
filter(Year!=2015 | Locality != "NUEVO MILENIO B7") %>%
filter(Year!=2016 | Locality != "APIPA SECTOR 12") %>%
filter(Year!=2016 | Locality != "APIPA SECTOR 12") %>%
filter(Year!=2016 | Locality != "VILLA CONO NORTE")
df <- df %>%
tibble::rowid_to_column("ID")%>%
mutate(ymin = ID- 0.9,
ymax = ID- 0.1)%>%
mutate(mak=pmax(ReportLag, SampleLag, SampleShipLag, DxLag, ControlLag,
na.rm=TRUE))%>%
arrange(mak)%>%
tibble::rowid_to_column("ID2")%>%
mutate(ymin2 = ID2- 0.9,
ymax2 = ID2- 0.1)
View(df)
Pal1 <- data.frame(vals = c("red3", "orangered", "orange", "lightgoldenrod",
"lightyellow", "palegreen"),
breaks = c("Lag1", "Lag2", "Lag3", "Lag4", "Lag5", "Lag6"),
labels = c("Initial rabies symptoms - MOH report",
"MOH report - dog euthanasia",
"Dog euthanasia - sample collection",
"Sample collection - sample shipment",
"Sample shipment - laboratory diagnosis",
"Labratory diangosis - focus control activities"))
View(Pal1)
fig <- ggplot(data=df)+
theme_classic()+
geom_rect(mapping=aes(xmin=0, xmax= ControlLag, ymin=ymin, ymax=ymax, fill="Lag6"), color="black")+
geom_rect(mapping=aes(xmin=0, xmax= DxLag, ymin=ymin, ymax=ymax, fill="Lag5"), color="black")+
geom_rect(mapping=aes(xmin=0, xmax= SampleShipLag, ymin=ymin, ymax=ymax, fill="Lag4"), color="black")+
geom_rect(mapping=aes(xmin=0, xmax= SampleLag, ymin=ymin, ymax=ymax, fill="Lag3"), color="black")+
geom_rect(mapping=aes(xmin=0, xmax= CullLag, ymin=ymin, ymax=ymax, fill="Lag2"), color="black")+
geom_rect(mapping=aes(xmin=0, xmax= ReportLag, ymin=ymin, ymax=ymax, fill="Lag1"), color="black")+
scale_fill_manual(values = Pal1$vals, name= "", breaks=Pal1$breaks, labels=Pal1$labels)+
theme(axis.text.y = element_blank(), axis.ticks = element_blank())+
ggtitle("Timeline of rabies response (chronological)") +
xlab("Time since initial symptoms (days)")+
ylab("Individual rabid dogs, newest --> oldest")
fig
